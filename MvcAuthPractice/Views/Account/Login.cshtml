@model User

<h1>Вхід</h1>

<form asp-action="Login" method="post">
    <label>Електронна пошта</label>
    <input name="Email" value="@Model.Email" />

    <label>Пароль</label>
    <input name="Password" type="password" />

    <span class="error">@ViewBag.Error</span>
    <button type="submit">Увійти</button>
</form>
